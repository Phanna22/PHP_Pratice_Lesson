function checkResult($score)
{
    if ($score >= 50) {
        return "Pass";
    } else {
        return "Fail";
    }
}

$students = [
    ["name" => "Sophea", "score" => 78],
    ["name" => "Dara",   "score" => 42],
    ["name" => "Vuthy",  "score" => 55],
];
?>
